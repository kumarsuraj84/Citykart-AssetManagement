    "sm":  { "value": "0.5rem" },
    "md":  { "value": "0.625rem" },
    "lg":  { "value": "0.75rem" },
    "xl":  { "value": "1rem" },
    "2xl": { "value": "1.25rem" },
    "3xl": { "value": "1.5rem" },
