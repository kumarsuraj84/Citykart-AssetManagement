# Env files of the two disposable perf stacks (values were throw-away; the JWT secrets are not reproduced here).
# ---- ckam-pf-old (code at 4ba4e94, built from `git archive 4ba4e94` in a scratch folder) ----
# DB_PORT=25482
# API_PORT=8800
# WEB_PORT=3811
# POSTGRES_PASSWORD=<throw-away>
# JWT_SECRET=<throw-away random 48 chars>
# BASE_URL=http://localhost:3811
# COOKIE_SECURE=false
# PO_SOURCE_HOST=            (all PO_SOURCE_* empty: NO ERP link)
# ENVIRONMENT_NAME=uat
# ---- ckam-pf-new (working tree at 734fd19, Alembic head c6e8a0b2d4f6) ----
# DB_PORT=25492
# API_PORT=8900
# WEB_PORT=3911
# POSTGRES_PASSWORD=<throw-away>
# JWT_SECRET=<throw-away random 48 chars>
# BASE_URL=http://localhost:3911
# COOKIE_SECURE=false
# PO_SOURCE_HOST=            (all PO_SOURCE_* empty: NO ERP link)
# ENVIRONMENT_NAME=uat
# CKAM_EDGE_SUBNET=172.31.215.0/28
# CKAM_WEB_IP=172.31.215.10
#
# Commands used (from the repo root for new, from the scratch export for old):
#   docker compose -p ckam-pf-old -f old-src/docker-compose.yml -f old-override.yml --env-file old.env up -d --build db api web
#   docker compose -p ckam-pf-new -f docker-compose.yml -f new-override.yml --env-file new.env up -d --build db api web
#   docker exec <api> alembic upgrade head
#   docker exec -w /app -e PYTHONPATH=/app <api> python /tmp/seed_perf.py
#   docker cp <new web>:/usr/share/nginx/html dist ; docker cp dist <each api>:/tmp/dist   (same build in both)
#   docker exec <db> psql -U ckam -d ckam -c "create extension pg_stat_statements"
#   node bench.mjs main ; node bench.mjs stmts ; node bench.mjs trigger
#   (recreate new api with new-override-rl.yml) node bench.mjs rl ; (back to new-override.yml) TAG=repeat BIG=15 node bench.mjs main <ops>
#   docker compose -p ckam-pf-old ... down -v --rmi local ; docker compose -p ckam-pf-new ... down -v --rmi local
