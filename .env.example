POSTGRES_PASSWORD=change_me
# Long random value, e.g. `openssl rand -hex 32`. The API logs a loud WARNING at
# startup if this is left unset (it then falls back to a dev secret that is
# committed to the repo and lets anyone forge tokens).
JWT_SECRET=change_me_too
# Public address of the WEB app (nginx, port 3211) as a phone on the LAN would
# reach it -- NOT localhost and NOT the API's :8000. Printed QR labels encode
# ${BASE_URL}/assets/{id}, so set this to the real LAN hostname/IP in production,
# e.g. http://assets.citykart.local:3211 or http://192.168.1.50:3211.
BASE_URL=http://localhost:3211
# Where nightly backups land on the host. In production, a folder on a disk that
# is itself backed up / copied off the server, e.g. /srv/ckam/backups.
BACKUP_DIR=./backups
# Only set to true if the site is served over HTTPS (Secure cookies are never
# sent over plain HTTP, which would break session refresh).
COOKIE_SECURE=false
# Host ports. db and api are bound to 127.0.0.1 in docker-compose.yml (not
# reachable from other LAN devices); only the web port is LAN-facing. Change a
# port if something else on the machine already uses it (e.g. a native
# PostgreSQL on 5432 -> DB_PORT=25432), or that service won't start.
WEB_PORT=3211
DB_PORT=5432
API_PORT=8000
